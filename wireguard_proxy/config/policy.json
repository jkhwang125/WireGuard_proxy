{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "policy_version": "1.0",
  "global_default_action": "ALLOW",
  "audit_logging": true,
  "protocols": {
    "http": {
      "enabled": true,
      "rules": [
        {
          "id": "http-block-admin-path",
          "match": {
            "methods": ["POST", "PUT", "DELETE"],
            "hosts": ["*"],
            "path_pattern": "^/api/v1/admin/.*"
          },
          "action": {
            "type": "BLOCK_REDIRECT",
            "redirect_url": "/security-block-notice.html",
	    "response_body": "<html>\n<body>\n<h1>Security block</h1>\n<p>Blocked due to unauthorized access</p>\n</body>\n</html>\n",
            "status_code": 302
          },
          "audit_message": "Blocked unauthorized administrative write operation."
        },
        {
          "id": "http-block-sql-keywords",
          "match": {
            "methods": ["GET"],
            "hosts": ["db-gateway.internal"],
            "path_pattern": ".*union.*select.*"
          },
          "action": {
            "type": "BLOCK_PAGE",
            "response_body": "<html><body><h1>403 Forbidden</h1><p>Request blocked by security audit policy.</p></body></html>",
            "status_code": 403
          },
          "audit_message": "Blocked potential SQL injection vector in query string."
        },
        {
          "id": "http-modify-inject-audit-header",
          "match": {
            "methods": ["GET", "POST"],
            "hosts": ["*"],
            "path_pattern": "^/api/v1/testuser/.*"
          },
          "action": {
            "type": "MODIFY",
            "inject_headers": {
              "X-Proxy-Gateway": "Secure-L7-Gateway",
              "X-Request-Audited": "true"
            },
            "strip_headers": ["X-Unwanted-Client-Header"]
          },
          "audit_message": "Injected security headers for authorized user route."
        }
      ]
    },
    "http2": {
      "enabled": true,
      "rules": [
        {
          "id": "http2-block-restricted-domains",
          "match": {
            "methods": ["CONNECT","POST"],
            "hosts": [
              
              "restricted-archive.org"
            ]
          },
          "action": {
            "type": "BLOCK",
            "status_code": 403,
	    "response_body": "<html><body><h1>403 Forbidden</h1><p>Request blocked by security audit policy.</p></body></html>"
	  },
          "audit_message": "Blocked encrypted HTTP/2 tunnel connection to restricted domain."
        },
        {
          "id": "http2-allow-trusted-gutenberg",
          "match": {
            "methods": ["CONNECT"],
            "hosts": [
              "www.gutenberg.org"
            ]
          },
          "action": {
            "type": "ALLOW"
          },
          "audit_message": "Allowed authorized HTTP/2 tunnel for digital library access."
        }
      ]
    }
  }
}
